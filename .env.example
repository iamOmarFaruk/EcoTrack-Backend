# Environment Configuration
NODE_ENV=development
PORT=5001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://your-frontend.vercel.app

# Database Configuration
# MongoDB Atlas connection string - DO NOT commit real credentials to git
# Get from: MongoDB Atlas → Connect → Connect your application
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_DATABASE=ecotrack

# Firebase Admin SDK - DO NOT commit real keys to git
# Get from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_ACTUAL_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Security Configuration
# Generate strong secrets with: openssl rand -base64 64
JWT_SECRET=your-generated-jwt-secret-here
ADMIN_JWT_SECRET=your-generated-admin-jwt-secret-here

# Admin Configuration
# Generate password hash with: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('YOUR_PASSWORD', 12).then(console.log)"
ADMIN_EMAIL=admin@ecotrack.com
ADMIN_NAME=EcoTrack Admin
ADMIN_PASSWORD_HASH=your-bcrypt-hashed-password-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookie Security
COOKIE_DOMAIN=localhost
